# Single-user app authentication. Generate a long random value.
REFRESCUE_TOKEN=replace-with-a-long-random-token
REFRESCUE_PROVIDER=steel
REFRESCUE_PUBLIC_BASE_URL=https://your-refrescue-host.example

# Cloud browser. The profile is created once by scripts/bootstrap-steel.mjs.
STEEL_API_KEY=replace-me
STEEL_PROFILE_ID=replace-after-bootstrap
STEEL_MYLOFT_EXTENSION_ID=replace-after-bootstrap
# Official MyLOFT extension by Eclat Engineering Pvt. Ltd. (Chrome Web Store ID: hljakogpibfgelmoegmajaeefcnefngd)
MYLOFT_CHROME_WEBSTORE_URL=https://chromewebstore.google.com/detail/myloft/hljakogpibfgelmoegmajaeefcnefngd

# Optional. When deployed on Vercel with Blob, configure Blob for persistent PDFs.
# BLOB_READ_WRITE_TOKEN=...

# Optional restrictive override; if set, it replaces the built-in scholarly host list.
# REFRESCUE_ALLOWED_HOSTS=doi.org,acs.org,sciencedirect.com,springer.com,wiley.com,rsc.org
