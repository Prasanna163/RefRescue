# Required. Generate with: npm run token
REFRESCUE_TOKEN=replace-with-a-long-random-token

# Chrome DevTools endpoint used by the dedicated MyLOFT browser profile.
CHROME_CDP_URL=http://127.0.0.1:9222

# Local API binding. Keep loopback; expose it with a trusted HTTPS tunnel.
HOST=127.0.0.1
PORT=8787

# Optional comma-separated host suffixes. If omitted, RefRescue uses its built-in
# scholarly-publisher allowlist. Setting this REPLACES the defaults.
# REFRESCUE_ALLOWED_HOSTS=myloft.xyz,doi.org,acs.org,sciencedirect.com,springer.com,wiley.com
