{
  "name": "refrescue-institutional-access",
  "version": "0.2.0",
  "description": "A minimal institutional-entitlement gateway for ChatGPT research workflows, with MyLOFT as the first provider.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server-cloud.mjs",
    "start:local": "node src/server.mjs",
