    "check": "npm test"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vercel/blob": "2.6.1",
    "pdf-parse": "2.4.5",
    "playwright": "1.62.0",
    "steel-sdk": "0.18.0",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}
